NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://betapp:betapp@localhost:5432/betapp
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5000
# Integration testleri için production bağlantısından ayrı bir URL kullanın.
DB_TEST_DATABASE_URL=
DB_TEST_SCHEMA=betapp_test_integration
LOG_LEVEL=info
COLLECTOR_ENABLED=true
BACKFILL_ENABLED=false
FOTMOB_ENABLED=true
SUPPORTED_COMPETITIONS=PremierLeague,LaLiga,Bundesliga,SerieA,Ligue1,SuperLig,ChampionsLeague,EuropaLeague,ConferenceLeague
COLLECTOR_INTERVAL_MS=900000
COLLECTOR_HISTORY_DAYS=2
COLLECTOR_FUTURE_DAYS=14
PROVIDER_TIMEOUT_MS=10000
PROVIDER_REQUESTS_PER_SECOND=2
PROVIDER_MAX_RETRIES=4
SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1
FOTMOB_BASE_URL=https://www.fotmob.com/api/data
IDDAA_BASE_URL=https://www.iddaa.com
FLASHSCORE_BASE_URL=https://www.flashscore.com
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_MS=300000
